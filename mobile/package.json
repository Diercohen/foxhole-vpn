{
  "name": "foxhole-mobile",
  "private": true,
  "description": "Foxhole for Android and iOS: the desktop app's window and core, in React Native",
  "scripts": {
    "prepare-android": "node scripts/prepare.mjs",
    "start": "react-native start",
    "android": "node scripts/prepare.mjs && react-native run-android",
    "build": "node scripts/prepare.mjs && cd android && ./gradlew assembleRelease",
    "build-ios": "node scripts/prepare.mjs ios && cd ios && pod install && xcodebuild -workspace Foxhole.xcworkspace -scheme Foxhole -configuration Release -destination generic/platform=iOS -derivedDataPath build -allowProvisioningUpdates DEVELOPMENT_TEAM=$FOXHOLE_TEAM MARKETING_VERSION=$(node -p \"require('../../package.json').version\") build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "codegenConfig": {
    "name": "FoxholeSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "io.github.diercohen.foxhole"
    },
    "ios": {
      "modulesProvider": {
        "Foxhole": "FoxholeModule"
      }
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
