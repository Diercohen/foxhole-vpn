<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- hev-socks5-tunnel's AAR says Android 10, but 2.18.0's libraries load on Android 7 and later (no ELF TLS) -->
    <uses-sdk tools:overrideLibrary="hev.socks5.tunnel" />

    <!-- split tunneling's apps to pick from (Phone.apps): those in the launcher, a TV's too (Android 11+ hides the rest) -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- connected: the notification, and the service that keeps the proxy running for other apps -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- an update: its APK, downloaded by the app, to Android's installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Sign in a TV: a phone scans the TV's QR code -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- the Wi-Fi's name, which Android shows only to apps allowed precise Location: asked for only when the user
         chooses to see it (Phone.wifiAccess) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <!-- a TV (Android TV) too: its launcher, its remote -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:banner="@drawable/banner"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:pageSizeCompat="enabled"
      android:supportsRtl="true">
      <activity
        android:name=".FoxholeActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- a QR code scanned with the camera app: its page opens Foxhole with it, a TV's (tvpair.ts) or shared settings (share.ts) -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="foxhole" android:host="tv" />
            <data android:scheme="foxhole" android:host="settings" />
        </intent-filter>
      </activity>
      <!-- Foxhole in the launcher: an alias, which disguise mode turns off (Disguise.kt), under the window's old name so
           home screen icons from before keep working -->
      <activity-alias
        android:name=".MainActivity"
        android:targetActivity=".FoxholeActivity"
        android:label="@string/app_name"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
      </activity-alias>
      <!-- disguise mode's calculator, in the launcher in Foxhole's place while it's on (Disguise.kt); a task of its own,
           or opening it could bring Foxhole's window back -->
      <activity
        android:name=".CalculatorActivity"
        android:label="@string/calculator"
        android:icon="@mipmap/ic_calculator"
        android:roundIcon="@mipmap/ic_calculator"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:taskAffinity="${applicationId}.calculator"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- whole-system mode's VPN, and what keeps Foxhole running while connected -->
      <service
        android:name=".FoxholeService"
        android:permission="android.permission.BIND_VPN_SERVICE"
        android:foregroundServiceType="specialUse"
        android:exported="false">
        <intent-filter>
            <action android:name="android.net.VpnService" />
        </intent-filter>
        <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="A local VPN proxy other apps connect to: it runs while the user has it connected, or paused to resume from its notification" />
      </service>
      <!-- Quick Settings' tile: on or off at a tap (FoxholeTile.kt) -->
      <service
        android:name=".FoxholeTile"
        android:exported="true"
        android:icon="@drawable/ic_notify"
        android:label="@string/app_name"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
            <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
        <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
      </service>
      <!-- the home screen's widget: the data left, and whether Foxhole's on (DataWidget.kt) -->
      <receiver
        android:name=".DataWidget"
        android:exported="false"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/data_widget" />
      </receiver>
      <!-- the update's APK, for Android's installer to read (Phone.apkInstall) -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.updates"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/updates" />
      </provider>
    </application>
</manifest>
