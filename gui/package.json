{
  "name": "foxhole-desktop",
  "productName": "Foxhole",
  "version": "0.9.2",
  "description": "Foxhole VPN's desktop app: Firefox's free VPN for your whole system (unofficial)",
  "homepage": "https://github.com/Diercohen/foxhole-vpn#readme",
  "author": "Dier Cohen",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "core": "npm --prefix .. run build && node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.cpSync('../dist', 'dist', { recursive: true })\"",
    "start": "npm run core && electron .",
    "dist": "npm run core && node build/wifi.mjs && electron-builder",
    "test": "npm run core && node updater.test.mjs && node accounts.test.mjs",
    "flags": "electron flag-icons.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.diercohen.foxhole",
    "productName": "Foxhole",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["main.js", "controller.js", "tray.js", "badge.js", "updater.js", "preload.cjs", "signin.cjs", "renderer/**/*", "dist/**/*", "build/icon.png", "build/tray/*.png", "build/flags/*.png"],
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.utilities", "identity": "-", "hardenedRuntime": false,
      "extendInfo": { "NSCameraUsageDescription": "Foxhole scans a TV's QR code with the camera, to sign the TV in." },
      "extraFiles": [{ "from": "build/Foxhole Wi-Fi.app", "to": "Helpers/Foxhole Wi-Fi.app" }], "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "win": { "target": "nsis" },
    "nsis": { "artifactName": "${productName}-${version}-setup.${ext}" },
    "appImage": { "artifactName": "${productName}-${version}.${ext}" },
    "deb": { "artifactName": "foxhole-desktop_${version}_amd64.${ext}" },
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Network",
      "maintainer": "Dier Cohen <Diercohen@users.noreply.github.com>"
    }
  }
}
